# --- Proxy (Único puerto expuesto al host) ---
PROXY_PORT=8080

# --- Escalado ---
API_REPLICAS=2

# --- Base de Datos (PostgreSQL) ---
POSTGRES_USER=campusbite_user
POSTGRES_PASSWORD=cambia_esta_clave_segura
POSTGRES_DB=campusbite_db
DB_HOST=postgres
DB_PORT=5432

# --- Broker de Mensajería (Kafka) ---
KAFKA_BROKER=kafka:9092
TOPICO_PEDIDO_CREADO=pedido-creado
TOPICO_PEDIDO_LISTO=pedido-listo

# --- Puertos internos de los servicios (no expuestos al host) ---
API_INTERNAL_PORT=5000
COCINA_INTERNAL_PORT=5001
ESTADISTICAS_INTERNAL_PORT=5002
WS_INTERNAL_PORT=8765